#!/bin/sh
# shuttle native initramfs /init (issue #75)
#
# Boots a shuttle disk: a dm-verity-protected ext4 root identified only by
# GPT PARTUUID on the kernel cmdline. There is no udev, no systemd and no
# initramfs tooling here — busybox + veritysetup and a handful of kernel
# modules is the whole world.
#
# Boot contract (src/image/verity.rs::verity_trailing):
#   root=PARTUUID=<root-uuid>
#   roothash=<64-hex>
#   systemd.verity_root_data=/dev/disk/by-partuuid/<root-uuid>
#   systemd.verity_root_hash=/dev/disk/by-partuuid/<hash-uuid>
#
# /modules.load is build-generated by the Rust assembly lane: one module
# path per line, absolute (/-rooted) within the initramfs, in load order.
# Blank lines and lines starting with '#' are ignored. Each module is
# loaded with insmod; a single failure aborts the boot loudly.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# Emit a marker to /dev/console AND stdout so the QEMU serial log is
# parseable. For PID 1 the kernel normally opens stdout ON the console, so
# stdout and /dev/console are the same hardware stream and an unconditional
# second write would duplicate every marker. Write to stdout always; add an
# explicit /dev/console write only when stdout is not itself a tty (e.g.
# when /init is launched with stdout redirected).
log() {
    printf 'SHUTTLE-INIT: %s\n' "$*"
    if [ -w /dev/console ] && [ ! -t 1 ]; then
        printf 'SHUTTLE-INIT: %s\n' "$*" > /dev/console
    fi
}

# Never exit silently: print FAIL, then hand the console to a shell. An
# automated `-serial file:` run reads EOF and the shell exits (tripping
# panic=<n>); an interactive boot gets a prompt.
fail() {
    log "FAIL $*"
    exec sh </dev/console >/dev/console 2>&1
}

# Print the value of KEY from the space-separated /proc/cmdline.
cmdline_value() {
    key="$1"
    for tok in $(cat /proc/cmdline); do
        case "$tok" in
            "$key"=*) printf '%s' "${tok#"$key"=}"; return 0 ;;
        esac
    done
    return 1
}

# Normalize a GPT PARTUUID read as raw little-endian field bytes into the
# canonical lowercase-hex form (no separators). GPT stores the first three
# UUID fields little-endian (4 + 2 + 2 bytes), then the last two fields as-is
# (2 + 6 bytes); a hexdump gives them in disk order, so the first three are
# byte-reversed to match the string sfdisk/blkid print.
#
# The swap uses `sed` only (no `cut`/`rev`): every one of those tools must
# otherwise be staged into the initramfs, and the applet set is deliberately
# minimal. `sed -E 's/(..)/\1 /g'` splits the hex into byte tokens, and the
# four output fields are assembled by position.
normalize_gpt_uuid() {
    hex=$(printf '%s' "$1" | tr 'A-F' 'a-f')
    # Space-separated bytes: "b1 b2 b3 ... b16".
    bytes=$(printf '%s' "$hex" | sed -E 's/(..)/\1 /g')
    # shellcheck disable=SC2086
    set -- $bytes
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s' \
        "$4" "$3" "$2" "$1" \
        "$6" "$5" \
        "$8" "$7" \
        "$9" "${10}" \
        "${11}" "${12}" "${13}" "${14}" "${15}" "${16}"
}

# Resolve a GPT PARTUUID to a /dev node WITHOUT udev — a minimal initramfs
# has no /dev/disk/by-partuuid/. util-linux findfs is tried first, but it
# resolves through libblkid's udev-populated cache and FAILS in a minimal
# initramfs (verified on 5.15.0-186: `findfs: unable to resolve`). The real
# path is therefore the direct GPT read below: the primary GPT header is at
# LBA 1 and its entry array at LBA 2 (byte 1024), 128 entries of 128 bytes,
# with the PARTUUID at offset 16 of the entry. The 16 bytes are read in disk
# order and re-ordered by `normalize_gpt_uuid` (mixed-endian).
resolve_partuuid() {
    uuid="$1"
    want=$(printf '%s' "$uuid" | tr 'A-F' 'a-f' | sed 's/-//g')

    if command -v findfs >/dev/null 2>&1; then
        dev=$(findfs "PARTUUID=$uuid" 2>/dev/null)
        if [ -n "$dev" ] && [ -b "$dev" ]; then
            printf '%s' "$dev"
            return 0
        fi
    fi

    for u in /sys/class/block/*/uevent; do
        [ -r "$u" ] || continue
        n=$(basename "$(dirname "$u")")
        # Only partition nodes: those carry PARTN, and their names end in a
        # digit (vda1, nvme0n1p1, mmcblk0p1).
        case "$n" in *[0-9]) ;; *) continue ;; esac
        p=$(sed -n 's/^PARTN=//p' "$u" 2>/dev/null)
        [ -n "$p" ] || continue
        [ -b "/dev/$n" ] || continue
        # The whole-disk node: derive it from the partition node name, NOT
        # from readlink. A partition is its own sysfs entry (`block/vda1`),
        # so `dirname(readlink -f .../vda1/uevent)` yields `block/vda/vda1`
        # and basename of THAT is still `vda1` — reading the partition node
        # at the disk's GPT offsets returns zeros. Strip the numeric
        # partition suffix instead: `vda1` -> `vda`, `nvme0n1p1` ->
        # `nvme0n1` / `mmcblk0p1` -> `mmcblk0` (the `p` separator when the
        # parent already ends in a digit), `sda2` -> `sda`.
        case "$n" in
            *p[0-9]*) d=${n%p[0-9]*} ;;
            *[!0-9][0-9]*) d=${n%[0-9]*} ;;
            *) d=$n ;;
        esac
        [ -b "/dev/$d" ] || continue
        # `od -v` is required: without it od folds a repeated-byte run into a
        # `*`, which silently truncates the comparison string.
        skip=$((1024 + (p - 1) * 128 + 16))
        got=$(dd if="/dev/$d" bs=1 skip="$skip" count=16 2>/dev/null \
              | od -An -v -tx1 | tr -d ' \n')
        if [ "$(normalize_gpt_uuid "$got")" = "$want" ]; then
            printf '%s' "/dev/$n"
            return 0
        fi
    done
    return 1
}

# The verity cmdline names devices as /dev nodes (accepted as-is) or as the
# /dev/disk/by-partuuid/<uuid> symlinks udev would have made.
resolve_verity_path() {
    path="$1"
    case "$path" in
        /dev/disk/by-partuuid/*) resolve_partuuid "${path##*/}" ;;
        /dev/*)                  printf '%s' "$path" ;;
        *)                       return 1 ;;
    esac
}

# /dev/mapper/control is a misc device. devtmpfs usually creates it, but if
# not, derive its minor from /proc/misc (major 10) so libdevmapper can talk
# to the device-mapper ioctl.
setup_dm_control() {
    [ -e /dev/mapper/control ] && return 0
    minor=$(awk '$2=="mapper"{print $1}' /proc/misc 2>/dev/null)
    [ -n "$minor" ] || return 1
    mknod /dev/mapper/control c 10 "$minor"
}

main() {
    log "start"

    # 1. Pseudo-filesystems. devtmpfs publishes /dev/console and the block
    #    device nodes the kernel already discovered.
    mount -t proc     proc     /proc || fail "mount /proc"
    mount -t sysfs    sysfs    /sys  || fail "mount /sys"
    mount -t devtmpfs devtmpfs /dev  || fail "mount /dev"
    mkdir -p /dev/mapper

    # 2. Boot-chain modules in the build-generated order.
    [ -f /modules.load ] || fail "missing /modules.load"
    while IFS= read -r mod; do
        case "$mod" in
            ''|'#'*) continue ;;
        esac
        insmod "$mod" || fail "insmod $mod"
    done < /modules.load
    log "modules-loaded"

    # 3. Parse the boot contract; a nil GUID means the build could not
    #    resolve a real partition and must not boot from the wrong volume.
    roothash=$(cmdline_value roothash) || fail "no roothash= on cmdline"
    data=$(cmdline_value systemd.verity_root_data) || fail "no systemd.verity_root_data="
    hash=$(cmdline_value systemd.verity_root_hash) || fail "no systemd.verity_root_hash="
    nil=00000000-0000-0000-0000-000000000000
    case "$data" in */by-partuuid/"$nil"|"$nil") fail "verity data device is nil PARTUUID" ;; esac
    case "$hash" in */by-partuuid/"$nil"|"$nil") fail "verity hash device is nil PARTUUID" ;; esac

    data_dev=$(resolve_verity_path "$data") || fail "resolve data device: $data"
    hash_dev=$(resolve_verity_path "$hash") || fail "resolve hash device: $hash"
    log "root=$data_dev hash=$hash_dev"

    # 4. Open the dm-verity mapping as /dev/mapper/root. cryptsetup >= 2.5
    #    `veritysetup open` takes the DATA device first and the mapping name
    #    second: `open <data_device> <name> <hash_device> [<root_hash>]`.
    #    (The legacy `create <name> <data> <hash>` order is the opposite one —
    #    using it with `open` fails with "Name must not contain '/'".)
    setup_dm_control || fail "no /dev/mapper/control"
    veritysetup open "$data_dev" root "$hash_dev" "$roothash" \
        || fail "veritysetup open"
    log "verity-open"

    # 5. Mount the verified root read-only (the verity mapping is read-only).
    mount -o ro /dev/mapper/root /sysroot || fail "mount /sysroot"
    log "mounted"

    # 6. Hand off to the real init in the verified root.
    log "switch-root"
    exec switch_root /sysroot /sbin/init
}

main
