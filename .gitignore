# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Build outputs from definition builds and smoke tests
*.snap
nau.lock
stage/
# Cross-process default-stage lock (flock sibling of stage/, never wiped)
stage.lock

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# CodeGraph index
.codegraph/
.venv/

# Local tooling artifacts (generated)
.audit/
graphify-out/

# Agent-tooling installs (impeccable skill's per-host drop): machine-local
# symlinks and per-agent copies, not repo infrastructure. The skill itself
# lives at ~/.agents/skills/impeccable.
.agents/skills/impeccable/
.codex/
.github/agents/
.github/hooks/
.github/skills/
.opencode/commands/
.opencode/skills/
.impeccable/

# The target/ claim file sits beside the build tree (scripts/target-claim.sh)
/target.claim

# Python bytecode from repo scripts
__pycache__/
