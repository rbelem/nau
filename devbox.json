{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "lua54Packages.lua@5.4.7",
    "pkg-config@latest",
    "github:NixOS/nixpkgs/c59305bab2065cfecc4944690d9eedbb56f3a9fa#rustfmt",
    "github:NixOS/nixpkgs/c59305bab2065cfecc4944690d9eedbb56f3a9fa#clippy",
    "github:NixOS/nixpkgs/c59305bab2065cfecc4944690d9eedbb56f3a9fa#cargo",
    "github:NixOS/nixpkgs/c59305bab2065cfecc4944690d9eedbb56f3a9fa#rustc",
    "github:NixOS/nixpkgs/nixos-unstable#squashfsTools",
    "autoconf@latest",
    "automake@latest",
    "bison@latest",
    "bubblewrap@latest",
    "gnumake@latest",
    "flex@latest",
    "patchelf@latest",
    "nodejs@latest",
    "python3@latest",
    "qemu@latest",
    "e2fsprogs@latest",
    "parted@latest",
    "mtools@latest",
    "dosfstools@latest",
    "github:NixOS/nixpkgs/nixos-unstable#pkgsStatic.busybox",
    "github:NixOS/nixpkgs/nixos-unstable#pkgsStatic.cryptsetup.bin",
    "github:NixOS/nixpkgs/nixos-unstable#pkgsStatic.util-linux.bin",
    "systemdUkify@latest",
    "cryptsetup@latest",
    "github:NixOS/nixpkgs/nixos-unstable#lua54Packages.luacheck",
    "github:NixOS/nixpkgs/nixos-unstable#stylua",
    "github:NixOS/nixpkgs/nixos-unstable#cargo-llvm-cov"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "build": "cargo build",
      "test": "NAU_SYSTEMD=off cargo test --workspace",
      "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
      "fmt": "cargo fmt --all",
      "fmt-check": "cargo fmt --all --check",
      "check": "NAU_SYSTEMD=off cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all --check"
    }
  }
}
