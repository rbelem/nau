{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "lua54Packages.lua@5.4.7",
    "pkg-config@latest",
    "rustfmt@1.95.0",
    "clippy@1.95.0",
    "cargo@1.95.0",
    "rustc@1.95.0",
    "squashfsTools@4.7.5",
    "autoconf@latest",
    "automake@latest",
    "bison@latest",
    "bubblewrap@latest",
    "gnumake@latest",
    "flex@latest",
    "patchelf@latest",
    "nodejs@latest",
    "python3@latest",
    "qemu@latest",
    "e2fsprogs@latest",
    "parted@latest",
    "mtools@latest",
    "dosfstools@latest",
    "github:NixOS/nixpkgs#pkgsStatic.busybox",
    "github:NixOS/nixpkgs#pkgsStatic.cryptsetup.bin",
    "github:NixOS/nixpkgs#pkgsStatic.util-linux.bin",
    "systemdUkify@latest",
    "cryptsetup@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "build": "cargo build",
      "test": "SHUTTLE_SYSTEMD=off cargo test",
      "clippy": "cargo clippy -- -D warnings",
      "fmt": "cargo fmt",
      "fmt-check": "cargo fmt --check",
      "check": "SHUTTLE_SYSTEMD=off cargo test && cargo clippy -- -D warnings && cargo fmt --check"
    }
  }
}
